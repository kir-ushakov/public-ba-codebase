{
  "screen": {
    "id": "task-view",
    "name": "Task View",
    "version": "1.3.0",

    "purpose": "Read a task and perform focused task actions without entering full edit mode.",

    "designSystem": "../design-system.json",
    "styleGuide": "../UI_STYLE_GUIDE.md",

    "status": "approved",
    "implementationStatus": "spec-only",

    "layout": {
      "type": "mobile",
      "structure": [
        "header",
        "task-type",
        "task-summary",
        "description",
        "cover-image",
        "tags",
        "quick-properties",
        "bottom-navigation"
      ]
    },

    "header": {
      "type": "page-header",

      "left": {
        "action": {
          "id": "back",
          "type": "icon-button",
          "icon": "arrow-left",
          "action": "navigate-back"
        },
        "title": {
          "text": "Task",
          "typographyToken": "typography.styles.pageTitle"
        }
      },

      "right": {
        "actions": [
          {
            "id": "more",
            "type": "icon-button",
            "icon": "more-vertical",
            "ariaLabel": "Task options",
            "action": "open-options-menu"
          }
        ]
      }
    },

    "content": {
      "taskType": {
        "label": "Task type",
        "component": "type-chip",
        "source": "task.type",
        "icon": "icons.taskType",
        "examples": [
          {
            "id": "todo",
            "label": "To do",
            "icon": "radio_button_unchecked"
          },
          {
            "id": "location",
            "label": "Location",
            "icon": "location_on"
          },
          {
            "id": "calendar",
            "label": "Calendar",
            "icon": "calendar_month"
          }
        ]
      },

      "summary": {
        "title": {
          "source": "task.title",
          "typographyToken": "typography.styles.pageTitle"
        },
        "status": {
          "component": "status-chip",
          "source": "task.status"
        },
        "dueDate": {
          "component": "compact-date",
          "source": "task.dueDate",
          "icon": "calendar"
        }
      },

      "description": {
        "label": "Description",
        "component": "read-only-content-card",
        "source": "task.description",
        "render": "rich-text"
      },

      "coverImage": {
        "label": "Image",
        "component": "task-cover-image",
        "source": "task.coverImage",
        "fit": "cover",
        "visibility": "when-present"
      },

      "tags": {
        "label": "Tags",
        "component": "tag-list",
        "source": "task.tags",
        "removable": false,
        "quickAdd": true,
        "addAction": {
          "label": "Add tag",
          "style": "dashed-chip"
        }
      },

      "quickProperties": [
        {
          "id": "status",
          "component": "property-row",
          "label": "Status",
          "value": "{task.status}",
          "icon": "status-{task.status}",
          "trailingIcon": "chevron-right",
          "action": "open-status-selector"
        },
        {
          "id": "due-date",
          "component": "property-row",
          "label": "Due date",
          "value": "{task.dueDate.relative}",
          "secondaryValue": "{task.dueDate.formatted}",
          "icon": "calendar",
          "trailingIcon": "chevron-right",
          "action": "open-due-date-selector"
        }
      ]
    },

    "states": {
      "default": {
        "description": "Standard read-only task details. The task type chip shows To do.",
        "referenceImage": "../references/task-view-todo.png"
      },

      "taskTypeLocation": {
        "description": "Task type chip shows Location.",
        "referenceImage": "../references/task-view-location.png",
        "taskType": {
          "id": "location",
          "label": "Location",
          "icon": "location_on"
        }
      },

      "taskTypeCalendar": {
        "description": "Task type chip shows Calendar.",
        "referenceImage": "../references/task-view-calendar.png",
        "taskType": {
          "id": "calendar",
          "label": "Calendar",
          "icon": "calendar_month"
        }
      },

      "statusSelectorOpen": {
        "trigger": "quick-properties.status",
        "referenceImage": "../references/task-view-status-selector.png",
        "overlay": {
          "component": "bottom-sheet",
          "title": "Set status",
          "dismiss": [
            "close-button",
            "swipe-down",
            "backdrop"
          ],
          "options": [
            {
              "id": "todo",
              "label": "To do",
              "description": "Not started yet",
              "icon": "status-todo"
            },
            {
              "id": "in-progress",
              "label": "In progress",
              "description": "Currently working on this",
              "icon": "status-in-progress"
            },
            {
              "id": "done",
              "label": "Done",
              "description": "Task completed",
              "icon": "status-done"
            },
            {
              "id": "cancelled",
              "label": "Cancelled",
              "description": "Task is no longer relevant",
              "icon": "status-cancelled"
            }
          ],
          "selected": "{task.status}",
          "selectionTreatment": "accent border and check icon",
          "primaryAction": {
            "label": "Apply",
            "style": "primary",
            "action": "update-task-status"
          }
        }
      },

      "optionsMenuOpen": {
        "trigger": "header.more",
        "referenceImage": "../references/task-view-options.png",
        "overlay": {
          "component": "context-menu",
          "anchor": "header.more",
          "items": [
            {
              "id": "edit",
              "label": "Edit task",
              "icon": "edit",
              "action": "open-task-edit"
            },
            {
              "id": "duplicate",
              "label": "Duplicate",
              "icon": "copy",
              "action": "duplicate-task"
            },
            {
              "id": "delete",
              "label": "Delete task",
              "icon": "trash",
              "semantic": "danger",
              "action": "open-delete-confirmation"
            }
          ]
        }
      },

      "deleteConfirmationOpen": {
        "trigger": "options-menu.delete",
        "overlay": {
          "component": "confirmation-dialog",
          "title": "Delete task?",
          "message": "This action removes the task.",
          "dangerAction": {
            "label": "Delete",
            "action": "delete-task"
          },
          "secondaryAction": {
            "label": "Cancel",
            "action": "close-dialog"
          }
        }
      }
    },

    "bottomNavigation": {
      "component": "bottom-navigation",
      "iconFamily": "Material Symbols Rounded",
      "items": [
        {
          "id": "home",
          "label": "Home",
          "icon": "home",
          "route": "/home",
          "active": true
        },
        {
          "id": "tasks",
          "label": "Tasks",
          "icon": "calendar_month",
          "route": "/tasks",
          "active": false
        },
        {
          "id": "tags",
          "label": "Tags",
          "icon": "sell",
          "route": "/tags",
          "active": false
        }
      ]
    },

    "visualRules": [
      "Use global design tokens from design-system.json.",
      "Do not define screen-specific colors, radii or arbitrary spacing.",
      "The reference PNG is a visual target, not a source of token values. Do not measure colors, spacing, or radii from it.",
      "Task content is read-only in the default state; full editing opens Task Edit.",
      "Status and due date are quick-edit property rows.",
      "Do not duplicate Done or Cancelled actions in the options menu; status changes belong to the status selector.",
      "The options menu contains object-level actions: Edit task, Duplicate and Delete task.",
      "Delete task uses the global danger semantic treatment and requires confirmation.",
      "The task type is a chip with the type label and the Material Symbol from design-system.json → icons.taskType. To do uses radio_button_unchecked. Do not use check or check_circle for To do.",
      "Display the task cover image as the primary media image when one exists.",
      "Keep overlays visually subordinate to the task and consistent with the global surface hierarchy.",
      "The status selector is a bottom sheet. Chrome, handle, backdrop and dismiss behavior come from design-system.json → bottomSheet. This state specifies only the sheet content.",
      "Bottom navigation is shared with Home: Home, Tasks, Tags. Use Material Symbols Rounded icons home, calendar_month and sell. Do not add Settings or a fourth tab.",
      "Settings, profile and integrations belong to the Home avatar account menu, not to bottom navigation."
    ],

    "reference": {
      "status": "approved",
      "image": "../references/task-view-todo.png",
      "description": "Approved visual reference for Task View when the task type is To do. Location and Calendar are separate references."
    },

    "angular": {
      "note": "The live Task View does not yet match this spec. It is title + optional description + single image, with a side drawer for Edit/Done/Cancel/Delete and a home icon instead of bottom navigation. Duplicate, due date, task tags, cover-vs-attachments, In progress, and the Location and Calendar task types are product destinations from the approved design, not claims that those fields, enum values, or Angular routes already exist. Live tasks are still ETaskType.Basic, shown as To do. Settings is not a Task View destination.",
      "screenFolder": "frontend/src/app/mobile-app/components/screens/task-screen/",
      "existingPiecesToReuse": [
        "frontend/src/app/mobile-app/components/screens/task-screen/task-view/",
        "frontend/src/app/mobile-app/components/screens/task-screen/task-side-menu/",
        "frontend/src/app/shared/components/ui-elements/rich-text-editor/",
        "frontend/src/app/mobile-app/components/screens/home-screen/home-bottom-panel/"
      ]
    }
  }
}
