{
  "screen": {
    "id": "home",
    "name": "Home",
    "version": "1.2.0",

    "purpose": "Main overview screen displaying the user's recent content and providing quick access to primary application areas.",

    "designSystem": "../design-system.json",
    "styleGuide": "../UI_STYLE_GUIDE.md",

    "status": "approved",
    "implementationStatus": "spec-only",

    "layout": {
      "type": "mobile",
      "structure": [
        "header",
        "content-grid",
        "floating-create-action",
        "bottom-navigation"
      ],

      "contentGrid": {
        "type": "masonry",
        "columns": 2,
        "gapToken": "spacing.scale.md",
        "screenPaddingToken": "spacing.screen.horizontalPadding"
      }
    },

    "header": {
      "type": "page-header",

      "left": {
        "title": {
          "text": "Home",
          "typographyToken": "typography.styles.pageTitle"
        },

        "subtitle": {
          "type": "item-count",
          "pattern": "{count} items",
          "typographyToken": "typography.styles.secondary"
        }
      },

      "right": {
        "actions": [
          {
            "id": "search",
            "type": "icon-button",
            "icon": "search",
            "ariaLabel": "Search"
          },
          {
            "id": "more",
            "type": "icon-button",
            "icon": "more-vertical",
            "ariaLabel": "More options"
          }
        ],

        "avatar": {
          "type": "user-avatar",
          "shape": "circle",
          "fallback": "initial",
          "action": "open-account-menu"
        }
      }
    },

    "content": {
      "type": "content-grid",

      "supportedCardTypes": [
        "image",
        "video",
        "task"
      ],

      "cards": {
        "image": {
          "component": "media-card",

          "structure": [
            "media",
            "title-row",
            "metadata"
          ],

          "media": {
            "type": "image",
            "fit": "cover"
          },

          "titleRow": {
            "leadingIcon": "task-type",
            "title": true,
            "overflowMenu": true
          },

          "metadata": [
            "createdAt"
          ]
        },

        "video": {
          "component": "media-card",

          "structure": [
            "media",
            "title-row",
            "description",
            "metadata"
          ],

          "media": {
            "type": "thumbnail",
            "fit": "cover"
          },

          "titleRow": {
            "leadingIcon": "task-type",
            "title": true,
            "overflowMenu": true
          },

          "description": {
            "maxLines": 2
          },

          "metadata": [
            "contentType",
            "createdAt"
          ]
        },

        "task": {
          "component": "task-card",

          "structure": [
            "title-row",
            "metadata"
          ],

          "titleRow": {
            "leadingIcon": "task-type",
            "title": true,
            "overflowMenu": true
          },

          "metadata": [
            "createdAt"
          ]
        }
      }
    },

    "floatingAction": {
      "id": "create",
      "component": "floating-action-button",
      "icon": "add",
      "ariaLabel": "Create",
      "action": "open-create-flow",

      "position": {
        "horizontal": "right",
        "vertical": "above-bottom-navigation"
      }
    },

    "accountMenu": {
      "component": "account-menu",
      "trigger": "header.avatar",
      "items": [
        {
          "id": "profile",
          "label": "Profile",
          "icon": "person"
        },
        {
          "id": "settings",
          "label": "Settings",
          "icon": "settings"
        },
        {
          "id": "integrations",
          "label": "Integrations",
          "icon": "hub"
        },
        {
          "id": "sign-out",
          "label": "Sign out",
          "icon": "logout",
          "semantic": "danger"
        }
      ]
    },

    "bottomNavigation": {
      "component": "bottom-navigation",
      "iconFamily": "Material Symbols Rounded",

      "items": [
        {
          "id": "home",
          "label": "Home",
          "icon": "home",
          "route": "/home",
          "active": true
        },
        {
          "id": "tasks",
          "label": "Tasks",
          "icon": "calendar_month",
          "route": "/tasks",
          "active": false
        },
        {
          "id": "tags",
          "label": "Tags",
          "icon": "sell",
          "route": "/tags",
          "active": false
        }
      ]
    },

    "responsive": {
      "mobileFirst": true,

      "mobile": {
        "columns": 2
      }
    },

    "visualRules": [
      "Use global design tokens from design-system.json.",
      "Do not define screen-specific colors.",
      "Do not define screen-specific border radii.",
      "Do not define arbitrary spacing values.",
      "The reference PNG is a visual target, not a source of token values. Do not measure colors, spacing, or radii from it.",
      "Media should remain the strongest visual element inside media cards.",
      "Cards may have different heights depending on their content.",
      "Do not force masonry cards to equal heights.",
      "The create action must remain visually dominant.",
      "The Home navigation item must use the global active navigation state.",
      "FAB add and bottom navigation use Material Symbols Rounded: add, home, calendar_month, sell.",
      "Bottom navigation destinations are Home, Tasks and Tags only. Do not add Settings as a fourth tab.",
      "The avatar opens the account menu: Profile, Settings, Integrations, Sign out.",
      "The leading icon on every Home card is the task type from design-system icons.taskType, not an image/video icon.",
      "Do not print TODO, TIMER, SCHEDULE or LOCATION as text on the card.",
      "Presence of an image does not change the leading icon.",
      "Current live type is TODO (ETaskType.Basic) using radio_button_unchecked. Do not use check or check_circle."
    ],

    "reference": {
      "status": "approved",
      "image": "../references/home.png",
      "description": "Dark two-column masonry Home screen with media-dominant cards, task-type leading icons, compact metadata, teal primary actions and persistent bottom navigation."
    },

    "angular": {
      "note": "The live Home screen does not yet match this spec. Treat this JSON as the approved target, not a description of the current implementation. Bottom-nav destinations /tasks and /tags are product destinations from the approved design; they are not a claim that those Angular routes already exist.",
      "screenFolder": "frontend/src/app/mobile-app/components/screens/mb-home-screen/",
      "existingPiecesToReuse": [
        "frontend/src/app/mobile-app/components/common/task-tiles-panel/",
        "frontend/src/app/shared/components/ui-elements/user-avatar/",
        "frontend/src/app/mobile-app/components/screens/mb-home-screen/mb-home-bottom-panel/"
      ]
    }
  }
}
