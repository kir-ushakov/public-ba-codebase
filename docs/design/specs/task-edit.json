{
  "screen": {
    "id": "task-edit",
    "name": "Edit Task",
    "version": "1.5.0",

    "purpose": "Edit an existing task using the same task-form pattern as Create Task, including its audio attachments.",

    "designSystem": "../design-system.json",
    "styleGuide": "../UI_STYLE_GUIDE.md",

    "status": "approved",
    "implementationStatus": "spec-only",
    "sharedPattern": "task-form",

    "layout": {
      "type": "mobile",
      "structure": [
        "header",
        "task-form",
        "bottom-actions"
      ]
    },

    "header": {
      "type": "page-header",

      "left": {
        "action": {
          "id": "back",
          "type": "icon-button",
          "icon": "arrow-left",
          "action": "navigate-back"
        },
        "title": {
          "text": "Edit Task",
          "typographyToken": "typography.styles.pageTitle"
        }
      },

      "right": {
        "actions": [
          {
            "id": "more",
            "type": "icon-button",
            "icon": "more-vertical",
            "ariaLabel": "More options"
          }
        ]
      }
    },

    "form": {
      "component": "task-form",
      "mode": "edit",
      "dataSource": "existing-task",
      "sections": [
        {
          "id": "title",
          "label": "Title",
          "component": "text-input",
          "placeholder": "Task title here...",
          "voiceInput": {
            "enabled": true,
            "icon": "mic",
            "action": "open-voice-record-title",
            "spec": "./voice-record-title.json"
          },
          "characterCount": true
        },
        {
          "id": "description",
          "label": "Description",
          "component": "rich-text-editor",
          "placeholder": "Write additional details about this task...",
          "toolbar": [
            "bold",
            "italic",
            "strikethrough",
            "bulleted-list",
            "numbered-list",
            "link"
          ],
          "characterCount": true
        },
        {
          "id": "audio-attachments",
          "label": "Audio attachments",
          "component": "audio-attachment-list",
          "designSystemPattern": "audioAttachment",
          "multiple": true,
          "source": "existing-task",
          "addAction": {
            "label": "Add audio recording",
            "icon": "mic",
            "action": "open-voice-record-audio",
            "spec": "./voice-record-audio.json"
          },
          "item": {
            "title": "Voice recording",
            "duration": true,
            "playback": ["play", "pause"],
            "withoutTranscription": {
              "action": {
                "label": "Transcribe with AI",
                "action": "transcribe-audio-attachment"
              }
            },
            "withTranscription": {
              "meta": "Transcription available",
              "action": {
                "label": "View transcription",
                "action": "view-audio-transcription"
              }
            },
            "transcriptionActions": ["copy-transcription", "add-transcription-to-description"],
            "remove": {
              "enabled": true,
              "action": "remove-audio-attachment",
              "removesTranscription": true
            }
          }
        },
        {
          "id": "images",
          "label": "Images",
          "component": "image-gallery-editor",
          "addAction": {
            "label": "Add image",
            "icon": "image",
            "action": "add-image"
          },
          "multiple": true,
          "cover": {
            "enabled": true,
            "selectionRule": "Exactly one attached image may be selected as cover when images exist.",
            "defaultRule": "The first added image becomes the cover automatically.",
            "tileUse": "The cover image is used as the task image on task tiles.",
            "selectedTreatment": [
              "accent selection border",
              "small COVER badge"
            ],
            "changeAction": "set-image-as-cover"
          }
        },
        {
          "id": "tags",
          "label": "Tags",
          "component": "tag-selector",
          "placeholder": "Add tags...",
          "multiple": true,
          "openAction": {
            "action": "open-tag-selector",
            "presentation": "bottom-sheet"
          },
          "selectedDisplay": {
            "component": "chip-list",
            "removable": true
          }
        },
        {
          "id": "status",
          "label": "Status",
          "component": "segmented-status-selector",
          "options": [
            {
              "id": "todo",
              "label": "Waiting",
              "icon": "status-todo"
            },
            {
              "id": "active",
              "label": "Active",
              "icon": "status-active"
            }
          ]
        },
        {
          "id": "conditions",
          "label": "Conditions",
          "component": "multi-select",
          "selection": "at-least-one",
          "options": [
            {
              "id": "todo",
              "label": "To do",
              "icon": "radio_button_unchecked"
            },
            {
              "id": "calendar",
              "label": "Calendar",
              "icon": "calendar_month"
            },
            {
              "id": "location",
              "label": "Location",
              "icon": "location_on"
            }
          ]
        },
        {
          "id": "due-date",
          "label": "Due date",
          "component": "date-selector",
          "emptyText": "Not set",
          "icon": "calendar"
        }
      ]
    },

    "bottomActions": {
      "component": "sticky-form-actions",
      "actions": [
        {
          "id": "cancel",
          "label": "Cancel",
          "style": "secondary",
          "action": "navigate-back"
        },
        {
          "id": "submit",
          "label": "Save Changes",
          "style": "primary",
          "action": "update-task"
        }
      ]
    },

    "states": {
      "tagSelectorOpen": {
        "trigger": "form.sections.tags",
        "spec": "./tag-selector-open.json",
        "referenceImage": "../references/tag-selector-open.png"
      },
      "voiceRecordTitle": {
        "trigger": "form.sections.title.voiceInput",
        "spec": "./voice-record-title.json",
        "referenceImage": "../references/voice-record-title.png"
      },
      "voiceRecordAudio": {
        "trigger": "form.sections.audio-attachments",
        "spec": "./voice-record-audio.json",
        "referenceImage": "../references/voice-record-audio.png"
      }
    },

    "visualRules": [
      "Use global design tokens from design-system.json.",
      "Do not define screen-specific colors, radii or arbitrary spacing.",
      "The reference PNG is a visual target, not a source of token values. Do not measure colors, spacing, or radii from it.",
      "Edit and Create must use the same task-form composition and shared components.",
      "Populate all fields from the existing task.",
      "Images are attachments; the selected cover image is used on task tiles.",
      "The title microphone opens Title Recording. It does not create an audio attachment.",
      "Audio attachments sit after Description and before Images. Existing recordings are listed with playback.",
      "Transcribe with AI is shown only when that attachment has no transcription. Otherwise the card offers View transcription.",
      "Add to description appends the saved transcript to the description. It does not replace the description or the audio file.",
      "Removing an audio attachment also removes its transcription. Deletion belongs on Edit, not on Task View.",
      "Tags have a single entry point. Use the Add tags selector to add or create tags; do not render a separate Add tag action beside selected tag chips.",
      "Do not show a trash/delete icon in the header.",
      "Do not show a clear-X control inside the title field.",
      "Deletion belongs to Task View options, not the Edit form."
    ],

    "reference": {
      "status": "approved",
      "image": "../references/task-edit.png",
      "description": "Approved visual reference for the Edit Task screen."
    },

    "angular": {
      "note": "Create and Edit share task-edit today. The live screen does not yet match this spec. Same data-shape caveats as task-create.json: single imageId, no dueDate on TaskDTO. The form offers Waiting and Active, plus a conditions multi-select (To do, Calendar, Location). A note is edited without a status or conditions selector. Mark as Active requires the todo condition. Mark as Active and Done are Task View actions. Task View does not show a status section. Calendar and location conditions do not store a date or place yet. Mockup counters are not TaskConst.",
      "screenFolder": "frontend/src/app/mobile-app/components/screens/task-screen/",
      "existingPiecesToReuse": [
        "frontend/src/app/mobile-app/components/screens/task-screen/task-edit/",
        "frontend/src/app/shared/components/ui-elements/rich-text-editor/",
        "frontend/src/app/shared/features/voice-input/components/voice-input-trigger/"
      ]
    }
  }
}
