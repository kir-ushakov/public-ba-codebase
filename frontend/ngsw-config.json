{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/assets/ui/**",
          "/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    },
    {
      "name": "apiImages",
      "resources": {
        "urls": ["/api/files/image/*"]
      }
    },
    {
      "name": "material-icons",
      "installMode": "prefetch",
      "resources": {
        "urls": ["https://fonts.googleapis.com/icon?family=Material+Icons&display=block"]
      }
    },
    {
      "name": "material-icon-files",
      "installMode": "lazy",
      "resources": {
        "urls": ["https://fonts.gstatic.com/s/materialicons/**"]
      }
    },
    {
      "name": "material-symbols",
      "installMode": "prefetch",
      "resources": {
        "urls": [
          "https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0,0&icon_names=add,calendar_month,home,hub,logout,more_vert,person,radio_button_unchecked,sell,settings&display=block"
        ]
      }
    },
    {
      "name": "material-symbol-files",
      "installMode": "lazy",
      "resources": {
        "urls": ["https://fonts.gstatic.com/s/materialsymbolsrounded/**"]
      }
    }
  ]
}
