{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["src/app/**/*.ts!", "tests/**/*.ts!"],
  "project": ["src/**/*.ts", "tests/**/*.ts"],
  "ignoreDependencies": [
    "ts-node",
    "@capacitor/angular",
    "@angular-eslint/schematics",
    "normalize.css",
    "crypto-js",
    "dotenv",
    "ng-mocks",
    "@types/jasmine",
    "@types/jasminewd2",
    "stylelint-config-prettier",
    "stylelint-config-standard",
    "yaml",
    "@emnapi/core",
    "@emnapi/runtime"
  ],
  "ignoreBinaries": ["playwright.e2e.config.js"],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "unresolved": "error",
    "exports": "off",
    "types": "off",
    "nsExports": "off",
    "nsTypes": "off",
    "duplicates": "warn",
    "enumMembers": "off"
  }
}
